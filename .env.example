# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=mysql://reachinbox:reachinbox_pass@localhost:3306/reachinbox
REDIS_URL=redis://localhost:6379

# Optional search accelerator. If omitted, search falls back to MySQL.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# Required for Google sign-in. Configure OAuth callback to /api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Optional Slack integration.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback
SLACK_NOTIFICATION_CHANNEL=

# Ethereal is for safe demo/test delivery only, not production campaigns.
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# Generate strong unique values for every deployment.
SESSION_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# Optional protected Bull Board dashboard. If unset, dashboard is disabled.
BULL_BOARD_USERNAME=
BULL_BOARD_PASSWORD=
