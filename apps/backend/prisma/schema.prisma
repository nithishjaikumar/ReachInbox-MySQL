datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String            @id @default(uuid())
  googleId        String            @unique
  name            String
  email           String            @unique
  avatarUrl       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  senders         Sender[]
  campaigns       Campaign[]
  slackConnection SlackConnection?
}

model Sender {
  id               String     @id @default(uuid())
  userId           String
  name             String
  email            String
  etherealUser     String?
  etherealPass     String?
  etherealHost     String?
  etherealPort     Int?
  active           Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  user             User       @relation(fields: [userId], references: [id])
  campaigns        Campaign[]
  emails           Email[]

  @@unique([userId, email])
}

model Campaign {
  id                 String   @id @default(uuid())
  userId             String
  senderId           String
  subject            String
  body               String    @db.LongText
  startTime          DateTime
  delayBetweenEmails Int      @default(2000)
  hourlyLimit        Int      @default(200)
  totalRecipients    Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id])
  sender             Sender   @relation(fields: [senderId], references: [id])
  emails             Email[]
}

model Email {
  id                 String    @id @default(uuid())
  campaignId         String
  senderId           String
  recipientEmail     String
  subject            String
  body               String    @db.LongText
  scheduledAt        DateTime
  sentAt             DateTime?
  status             String    @default("scheduled")
  attempts           Int       @default(0)
  bullJobId          String?
  idempotencyKey     String    @unique
  errorMessage       String?   @db.Text
  etherealPreviewUrl String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  campaign           Campaign  @relation(fields: [campaignId], references: [id])
  sender             Sender    @relation(fields: [senderId], references: [id])

  @@index([status])
  @@index([campaignId])
  @@index([senderId])
  @@index([scheduledAt])
}

model SlackConnection {
  id          String   @id @default(uuid())
  userId      String   @unique
  slackUserId String
  accessToken String
  teamId      String
  teamName    String
  channelId   String?
  connected   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}
